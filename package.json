{
  "name": "@nik3iw/eslint-config",
  "version": "1.2.1",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "Nik3iw",
  "description": "Shareable ESLint Config",
  "keywords": [
    "ESLint",
    "Config"
  ],
  "homepage": "https://github.com/Nik3iw/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nik3iw/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/Nik3iw/eslint-config/issues"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.66.0"
  },
  "devDependencies": {
    "@nik3iw/prettier-config": "^1.0.1",
    "@nik3iw/tsconfig": "^1.1.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.1.2",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
